#!/bin/bash
# ---- Common bootstrap (runs on every VM via cloud-init) ----
set -euxo pipefail
exec > >(tee -a /var/log/vprofile-setup.log) 2>&1
export DEBIAN_FRONTEND=noninteractive
export HOME=/root

# Wait for apt locks (unattended-upgrades often runs on first boot)
apt_get() { apt-get -o DPkg::Lock::Timeout=600 "$@"; }

# Replaces vagrant-hostmanager: every VM knows every other VM by name
cat >> /etc/hosts <<'HOSTS'
${hosts_entries}
HOSTS

%{ if ubuntu_password != "" ~}
# Password for the ubuntu user (console / RDP login; SSH still needs the key)
echo 'ubuntu:${ubuntu_password}' | chpasswd
%{ endif ~}

%{ if length(dns_servers) > 0 ~}
# Force DNS servers (the subnet's DHCP does not provide working ones)
mkdir -p /etc/systemd/resolved.conf.d
printf '[Resolve]\nDNS=${join(" ", dns_servers)}\n' > /etc/systemd/resolved.conf.d/dns.conf
systemctl restart systemd-resolved
%{ endif ~}

# Wait up to 5 minutes for DNS / internet; stop here with a clear error if it never works
for i in $(seq 1 30); do
  getent hosts archive.ubuntu.com && break
  echo "waiting for DNS ($i/30)..."; sleep 10
done
getent hosts archive.ubuntu.com

# Replaces "yum update -y"; failed repo downloads now stop the script
apt_get update -y --error-on=any
apt_get upgrade -y
